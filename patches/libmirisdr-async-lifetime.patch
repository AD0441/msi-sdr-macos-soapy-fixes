+static void mirisdr_async_control_lock(mirisdr_dev_t *p) {
+    while (atomic_exchange_explicit(&p->async_control_lock, 1, memory_order_acquire)) {
+#if defined (_WIN32) && !defined(__MINGW32__)
+        Sleep(1);
+#else
+        usleep(1000);
+#endif
+    }
+}
+
+static void mirisdr_async_control_unlock(mirisdr_dev_t *p) {
+    atomic_store_explicit(&p->async_control_lock, 0, memory_order_release);
+}
+
+/* A transfer remains owned by libusb until its completion callback returns. */
+static void mirisdr_async_set_active(mirisdr_dev_t *p,
+                                    struct libusb_transfer *xfer, int active) {
+    size_t i;
+    for (i = 0; i < p->xfer_buf_num; ++i) {
+        if (p->xfer[i] == xfer) {
+            p->xfer_active[i] = active;
+            return;
+        }
+    }
+}
+
+static int mirisdr_async_submit(mirisdr_dev_t *p, struct libusb_transfer *xfer) {
+    int r;
+    mirisdr_async_set_active(p, xfer, 1);
+    r = libusb_submit_transfer(xfer);
+    if (r < 0) mirisdr_async_set_active(p, xfer, 0);
+    return r;
+}
+
+static void mirisdr_async_drain(mirisdr_dev_t *p) {
+    size_t i;
+    int pending;
+    struct timeval tv = {0, 50000};
+    if (!p->xfer || !p->xfer_active) return;
+    for (;;) {
+        /* Serialize with callbacks, including callbacks on other event threads. */
+        libusb_interrupt_event_handler(p->ctx);
+        libusb_lock_events(p->ctx);
+        pending = 0;
+        for (i = 0; i < p->xfer_buf_num; ++i) {
+            if (!p->xfer_active[i]) continue;
+            pending = 1;
+            libusb_cancel_transfer(p->xfer[i]);
+        }
+        libusb_unlock_events(p->ctx);
+        if (!pending) return;
+        /* Cancellation is asynchronous: keep dispatching until every callback ran. */
+        libusb_handle_events_timeout(p->ctx, &tv);
+    }
+}
