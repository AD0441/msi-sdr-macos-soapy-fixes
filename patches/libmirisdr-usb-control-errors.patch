 #include "sync.c"
 
+struct mirisdr_usb_location {
+    uint16_t vid, pid;
+    uint8_t bus, ports[8];
+    int port_count;
+};
+
+static int mirisdr_claim_device(mirisdr_dev_t *dev) {
+    int r;
+    dev->driver_active = libusb_kernel_driver_active(dev->dh, 0) == 1;
+    if (dev->driver_active) {
+#ifdef DETACH_KERNEL_DRIVER
+        if ((r = libusb_detach_kernel_driver(dev->dh, 0)) < 0) return r;
+#else
+        /* Darwin reports any IORegistry child, including user-space clients.
+         * Let the exclusive claim determine whether the interface is busy. */
+        fprintf(stderr, "miri USB driver/client present; checking exclusive interface claim\n");
+#endif
+    }
+    r = libusb_claim_interface(dev->dh, 0);
+    if (r < 0) fprintf(stderr, "failed to claim miri USB interface: %d\n", r);
+    return r;
+}
+
+/* A reset may invalidate the handle. Rediscover only this physical connection,
+ * without issuing another reset or selecting another same-model receiver. */
+static int mirisdr_reopen_after_reset(mirisdr_dev_t *dev,
+                                     const struct mirisdr_usb_location *location) {
+    unsigned attempt;
+    libusb_release_interface(dev->dh, 0);
+    libusb_close(dev->dh);
+    dev->dh = NULL;
+    if (location->port_count <= 0) return LIBUSB_ERROR_NOT_FOUND;
+    for (attempt = 0; attempt < 80; ++attempt) {
+        libusb_device **list = NULL;
+        ssize_t i, count = libusb_get_device_list(dev->ctx, &list);
+        if (count < 0) return (int)count;
+        for (i = 0; i < count; ++i) {
+            struct libusb_device_descriptor dd;
+            uint8_t ports[8];
+            int r, port_count;
+            if (libusb_get_device_descriptor(list[i], &dd) < 0) continue;
+            if (dd.idVendor != location->vid || dd.idProduct != location->pid ||
+                libusb_get_bus_number(list[i]) != location->bus) continue;
+            port_count = libusb_get_port_numbers(list[i], ports, sizeof(ports));
+            if (port_count != location->port_count ||
+                memcmp(ports, location->ports, (size_t)port_count)) continue;
+            r = libusb_open(list[i], &dev->dh);
+            if (r == 0) {
+                libusb_free_device_list(list, 1);
+                fprintf(stderr, "miri USB reopened at the same physical port after reset\n");
+                return 0;
+            }
+            if (r != LIBUSB_ERROR_NO_DEVICE && r != LIBUSB_ERROR_NOT_FOUND) {
+                libusb_free_device_list(list, 1);
+                return r;
+            }
+        }
+        libusb_free_device_list(list, 1);
+#if defined (_WIN32) && !defined(__MINGW32__)
+        Sleep(25);
+#else
+        usleep(25000);
+#endif
+    }
+    return LIBUSB_ERROR_NO_DEVICE;
+}
